{
  "name": "@dar/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"apps/**/*.css\" \"packages/**/*.css\" --fix",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.3.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.0"
  }
}
