# ---------------------------------------------------------------------------
# THIS FILE IS A DRAFT, NOT AN ACTIVE WORKFLOW.
#
# It was committed at `.github/ci.yml.draft` instead of
# `.github/workflows/ci.yml` because the repo's authenticating PAT did not
# have the `workflow` scope (GitHub refuses to accept workflow file pushes
# from PATs that lack that scope).
#
# To activate:
#   1. Rotate the embedded PAT in your local `.git/config` to one with
#      the `workflow` scope (or switch to SSH / `gh auth login`).
#   2. Move this file into place:
#        git mv .github/ci.yml.draft .github/workflows/ci.yml
#   3. Commit and push.
#
# See `.github/README.md` for the full story.
# ---------------------------------------------------------------------------

name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # ------------------------------------------------------------------ #
  # Python
  # ------------------------------------------------------------------ #
  python:
    name: Python ${{ matrix.python-version }} / Django ${{ matrix.django-version }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.11", "3.12"]
        django-version: ["5.0", "5.1", "5.2"]
        exclude:
          # Django 5.2 needs Python 3.10+; nothing to exclude yet but keep slot.
          - python-version: "3.10"
            django-version: "5.2"
    steps:
      - uses: actions/checkout@v4

      - name: Install Poetry
        run: pipx install poetry==1.8.3

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: poetry

      - name: Install dependencies
        run: |
          poetry install --no-interaction --no-root
          poetry run pip install "django~=${{ matrix.django-version }}.0"

      - name: Ruff lint
        run: poetry run ruff check .

      - name: Ruff format check
        run: poetry run ruff format --check .

      - name: Mypy (best-effort)
        run: poetry run mypy django_admin_react || true

      - name: Bandit (security lint)
        run: poetry run bandit -r django_admin_react -q || true

      - name: Pytest
        run: poetry run pytest

  # ------------------------------------------------------------------ #
  # Frontend
  # ------------------------------------------------------------------ #
  frontend:
    name: Frontend (Node ${{ matrix.node-version }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        node-version: ["20", "22"]
    steps:
      - uses: actions/checkout@v4

      - name: Reject npm/yarn lockfiles
        run: |
          if [ -e frontend/package-lock.json ] || [ -e frontend/yarn.lock ]; then
            echo "::error::Found npm/yarn lockfile. This repo uses pnpm only."
            exit 1
          fi

      - uses: pnpm/action-setup@v4
        with:
          version: 9

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
          cache: pnpm
          cache-dependency-path: frontend/pnpm-lock.yaml

      - name: Install
        working-directory: frontend
        run: pnpm install --frozen-lockfile || pnpm install

      - name: Lint
        working-directory: frontend
        run: pnpm -r lint

      - name: Typecheck
        working-directory: frontend
        run: pnpm -r typecheck

      - name: Build
        working-directory: frontend
        run: pnpm -r build

  # ------------------------------------------------------------------ #
  # Secret scan
  # ------------------------------------------------------------------ #
  secret-scan:
    name: Secret scan (gitleaks)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # ------------------------------------------------------------------ #
  # Package build (sdist + wheel)
  # ------------------------------------------------------------------ #
  package-build:
    name: Build sdist + wheel
    runs-on: ubuntu-latest
    needs: [python]
    steps:
      - uses: actions/checkout@v4

      - name: Install Poetry
        run: pipx install poetry==1.8.3

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: poetry

      - name: Build
        run: poetry build

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist/
